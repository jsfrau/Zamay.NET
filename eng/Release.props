<Project>
  <PropertyGroup>
    <ZamayVersion>2.0.0</ZamayVersion>
    <Authors>ZamaySolves</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jsfrau/Zamay.NET</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
